rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collections de l'appli « Mes Arbres » (préfixe arb_) — accès réservé aux comptes listés.
    // Ajoutez ici les e-mails des personnes autorisées (vous, associé, ouvrier…).
    match /{col}/{id} {
      allow read, write: if col.matches('arb_.*')
        && request.auth != null
        && request.auth.token.email in ['amine.sfax@gmail.com'];
    }
  }
}
